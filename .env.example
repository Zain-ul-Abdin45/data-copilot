# Copy to .env and source it (`set -a; source .env; set +a`), or export these directly —
# settings.py reads every one of these as a plain environment variable with the same defaults
# shown here, so an untouched .env.example behaves exactly like having no .env at all.

# --- which engine (see README's "Data sources") -------------------------------------------
# postgres | duckdb | trino. DBT_TARGET follows this automatically unless set separately.
COPILOT_DATASOURCE=postgres
# DBT_PROJECT_DIR=dbt-test-project   # default; override only to point at a different dbt project

# --- postgres (COPILOT_DATASOURCE=postgres) ------------------------------------------------
COPILOT_DB_HOST=localhost
COPILOT_DB_NAME=data_copilot
COPILOT_DB_USER=copilot_ro
COPILOT_DB_PASSWORD=copilot_ro

# --- duckdb (COPILOT_DATASOURCE=duckdb): a local file, no server, no login ------------------
# COPILOT_DUCKDB_PATH=./warehouse.duckdb

# --- trino (COPILOT_DATASOURCE=trino): see trino/README.md -----------------------------------
# COPILOT_TRINO_HOST=localhost
# COPILOT_TRINO_PORT=8080
# COPILOT_TRINO_USER=copilot_ro
# COPILOT_TRINO_CATALOG=warehouse
# COPILOT_TRINO_SCHEMA=analytics

# --- model (Ollama) -------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434/api/chat
COPILOT_MODEL=qwen3:14b
COPILOT_EMBED_MODEL=nomic-embed-text
# ~15s/question with thinking off; ~3min with it on. Off by default, escalated automatically
# when an answer needs it (see README's "Fast first").
COPILOT_THINK=false
COPILOT_ESCALATE=true
COPILOT_NUM_CTX=16384

# --- safety / governance ---------------------------------------------------------------------
COPILOT_MASK_PII=true
COPILOT_ALLOW_RUN_SQL=true
# re-ranks search_catalog among entries keyword overlap already matched (never decides a match
# on its own); needs `ollama pull nomic-embed-text`. See catalog.py's docstring before enabling.
COPILOT_CATALOG_EMBEDDINGS=false

# --- API (main.py) ---------------------------------------------------------------------------
# Empty (default) means no auth, matching the current "localhost only" trust model. Set this
# before exposing /ask beyond localhost.
# COPILOT_API_TOKEN=

# --- UI (ui/app.py, Chainlit) -----------------------------------------------------------------
# COPILOT_UI_STUB=1          # canned answers, no model needed — useful for trying the UI itself
# COPILOT_UI_THEME=dark      # also set default_theme in ui/.chainlit/config.toml to match
# COPILOT_UI_USER=
# COPILOT_UI_PASSWORD=
